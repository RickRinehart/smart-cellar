# Smart Cellar — Environment Variables
# RG Digital Labs, LLC · June 2026
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.

# -- Supabase (shared project with Smart Kitchen) ------------------------------
VITE_SUPABASE_URL=https://wnlqvmedocpgjawmwivd.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -- Anthropic (Smart Cellar dedicated key — "smart-cellar" key from Anthropic console) --
VITE_ANTHROPIC_KEY=your_smart_cellar_anthropic_key_here

# -- Stripe (shared live account with Smart Kitchen) --------------------------
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_live_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here   # server-side only (Vercel env)

# -- Resend (thesmartkitchenapp workspace, smart-cellar sender) ----------------
RESEND_API_KEY=your_resend_api_key_here

# -- App URLs ------------------------------------------------------------------
VITE_APP_URL=https://smart-cellar.vercel.app          # update after Vercel deploy
VITE_SMART_KITCHEN_URL=https://smart-kitchen-opal.vercel.app
